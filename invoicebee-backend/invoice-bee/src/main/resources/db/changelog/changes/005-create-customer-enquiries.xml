<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="017-create-customer-enquiries" author="invoicebee">
        <createTable tableName="customer_enquiries">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="shop_id" type="VARCHAR(36)">
                <constraints nullable="false" foreignKeyName="fk_customer_enquiries_shop" references="shops(id)"/>
            </column>
            <column name="customer_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="products_interested" type="TEXT"/>
            <column name="expected_visit_date" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(30)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="TEXT"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="customer_enquiries" indexName="idx_customer_enquiries_shop_id">
            <column name="shop_id"/>
        </createIndex>
        <createIndex tableName="customer_enquiries" indexName="idx_customer_enquiries_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
